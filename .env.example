# Copy to .env and override as needed. NEVER commit a real .env.
# These are local-dev placeholders only.

# PostgreSQL superuser password (container only)
POSTGRES_PASSWORD=postgres

# Password every service uses for its own database user.
# Passed to the init scripts on FIRST boot of an empty pgdata volume.
# Changing this later does not rotate passwords in an existing database.
DB_PASSWORD=changeme

# Seven JVMs share the host with PostgreSQL.
JAVA_TOOL_OPTIONS=-Xmx256m
